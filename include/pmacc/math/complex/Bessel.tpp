                        complex_64 const z4 = zz * zz;
                        r = evalpoly(
                                z4,
                                std::array<double,10>{0.5, 0.0026041666666666665, 6.781684027777778e-7, 3.363930569334215e-11,
                                                    5.214426105738801e-16, 3.2919356728148996e-21, 9.991549123491221e-27,
                                                    1.6338875463584545e-32, 1.564307163716351e-38, 9.342315267006072e-45}
