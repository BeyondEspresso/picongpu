                                                                  4.576360714471254e-31, -3.62565930854413e-33, -5.095559260340188e-34}
                                            );
                            }
                            else
                            {
                                r = evalpoly( _z - 16.0,
                                              std::array<double,31>{-0.1748990739836292, -0.09039717566130419, 0.09027444873123035, 0.01312662593374557,
                                                                  -0.007667362695010893, -0.0005550708142218287, 0.0002571415573791134, 1.0850297108500103e-5,
                                                                  -4.565690471161262e-6, -1.2026225777846727e-7, 4.9959717576483296e-8, 8.48815248845687e-10,
                                                                  -3.701703923085197e-10, -4.101051708969331e-12, 1.980421966657433e-12, 1.4173962555705988e-14,
