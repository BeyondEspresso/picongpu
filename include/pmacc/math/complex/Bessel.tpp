                                                                         -0.04136192882523951 - 0.10845822138428568 * im, -0.12376621749712938 - 0.1560380316634484 * im,
                                                                         0.1440093676081139 + 0.07630216514159634 * im, -0.11981155913520558 - 0.10502286007991138 * im,
                                                                         -0.09732103082699156 + 0.12394089091215946 * im, -0.2024491672690207 - 0.008074664453662488 * im,
