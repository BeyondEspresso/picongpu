                                                                         0.057776769164925704 - 0.2256791564859297 * im};
/**                         std::array<complex_64,17> const f = std::array<complex_64,17>{0.40650720354357883 - 0.006334133391405162 * im, 0.3996077953677851 - 0.0028305511728273568 * im,
 *                                                                         0.39967704085612976 - 0.0030016547219227385 * im, 0.4030249334706483 - 0.006007622393381157 * im,
 *                                                                         0.40100073574830397 - 0.004755573523837742 * im, 0.40005639633772716 - 0.003557024462101866 * im,
 *                                                                         0.4024594080667488 - 0.0008405204317908334 * im, 0.40054207447089496 - 0.004211100015366804 * im,
 *                                                                         0.40036795014598564 - 0.0018064878102966003 * im, 0.4045859012569077 - 0.00644263857738687 * im,
 *                                                                         0.3997607686595453 - 0.00268586039668089 * im, 0.4051483029145814 - 0.0031164474364945016 * im,
 *                                                                         0.4000585212223849 - 0.0024151743246614353 * im, 0.39982888182793785 - 0.003319036953780421 * im,
