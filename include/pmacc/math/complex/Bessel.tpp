                                                                  -6.482772100803784e-20, -7.615209126543415e-23, 1.3608987282597849e-22, 2.2067196209386653e-26,
                                                                  -2.3923906484884365e-25, 1.4153681120888267e-28, 3.5743243599678463e-28, -4.139824487468731e-31,
                                                                  -4.595455176935322e-31, 7.2929256888043685e-34, 5.138919311361309e-34}
                                            );
                            }
                            r = conj(r);
                        }
                    }
                    else
                    {
                        if (imz <= tan(PI / 5.) * rez)
                        {
                            complex_64 const zz = z * z;
                            complex_64 const z4 = zz * zz;
                            r = evalpoly( z4,
                                          std::array<double,18>{1.0, 0.015625, 6.781684027777777e-6, 4.709502797067901e-10, 9.385966990329842e-15,
                                                              7.242258480192779e-20, 2.5978027721077174e-25, 4.9016626390753635e-31, 5.318644356635594e-37,
                                                              3.5500798014623073e-43, 1.5365650110207356e-49, 4.499321282809354e-56, 9.228877211181495e-63,
                                                              1.3652185223641266e-69, 1.4929270885431173e-76, 1.232764473958843e-83, 7.829549665715613e-91,
                                                              3.887148093924665e-98}
                                        );
                            r += zz * evalpoly( z4,
                                                std::array<double,18>{0.25, 0.00043402777777777775, 6.781684027777778e-8, 2.4028075495244395e-12, 2.896903392077112e-17,
                                                                    1.4963343967340453e-22, 3.842903509035085e-28, 5.4462918211948485e-34, 4.60090342269515e-40,
                                                                    2.458504017633177e-46, 8.71068600351891e-53, 2.1263333094562166e-59, 3.691550884472598e-66,
