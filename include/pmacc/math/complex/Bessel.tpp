            using complex_64 = alpaka::Complex<double>;

            template<typename T_Type>
            struct CbesseljBase
            {
            public:
                using result = alpaka::Complex<T_Type>;
                using complex_T = alpaka::Complex<T_Type>;

                template <size_t N>
                HDINLINE double evalpoly(double x, const std::array<double, N>& coeffs)
                {
                    double y = 0.0;
                    size_t lenp = coeffs.size();
                    if (lenp == 0)
                    {
                        return 0.0;
                    }
                    else
                    {
                        double y(coeffs[lenp - 1]);
                        for (int ind = lenp - 2; ind >= 0; ind--)
                        {
                            y = coeffs[ind] + x * y;
                        }
                        return y;
                    }
                }

                template <size_t N>
                HDINLINE complex_64 evalpoly(complex_64 x, const std::array<double, N>& coeffs)
                {
                    complex_64 y(0.0, 0.0);
                    size_t lenp = coeffs.size();
                    if (lenp == 0)
                    {
                        return complex_64(0.0,0.0);
                    }
                    else
                    {
                        complex_64 y(coeffs[lenp - 1]);
                        for (int ind = lenp - 2; ind >= 0; ind--)
                        {
                            y = coeffs[ind] + x * y;
                        }
                        return y;
                    }
                }

                template <size_t N>
                HDINLINE complex_64 evalpoly(complex_64 x, const std::array<complex_64, N>& coeffs)
                {
                    complex_64 y(0.0, 0.0);
                    size_t lenp = coeffs.size();
                    if (lenp == 0)
                    {
                        return complex_64(0.0,0.0);
                    }
                    else
                    {
                        complex_64 y(coeffs[lenp - 1]);
                        for (int ind = lenp - 2; ind >= 0; ind--)
                        {
                            y = coeffs[ind] + x * y;
                        }
                        return y;
                    }
                }
            };

            template<>
            struct J0<alpaka::Complex<double>>
                : public CbesseljBase<double>
            {
            public:
                HDINLINE result operator()(complex_T const& zin)
                {
                    double const SQ1O2PI = 0.3989422804014327;
                    complex_64 const im = complex_64(0.0, 1.0);
                    double const PI = 3.141592653589793238462643383279502884197169399;
                    complex_64 z = zin / im;
                    complex_64 r = complex_64(1.0, 0.0);
                    bool isconj = false;

                    if (z.real() < 0.0)
                    {
                        z = -z;
                    }
                    if (z.imag() < 0.0)
                    {
                        z = conj(z);
                        isconj = true;
                    }
                    double const rez = z.real();
                    double const imz = z.imag();
                    if (math::norm(z) > 306.25)
                    {
                        // use asymptotic expansion for large arguments |z| > 17.5
                        complex_64 const zinv = 1.0 / z;
                        complex_64 const e = math::exp(z);
                        complex_64 const sinv = math::sqrt(zinv) * SQ1O2PI;
                        complex_64 const p = 
                            evalpoly( zinv * zinv,
                                      std::array<double,14>{1.0, 0.0703125, 0.112152099609375, 0.5725014209747314, 6.074042001273483,
                                                          110.01714026924674, 3038.090510922384, 118838.42625678325, 6.252951493434797e6,
                                                          4.259392165047669e8, 3.646840080706556e10, 3.8335346613939443e12,
                                                          4.8540146868529006e14, 7.286857349377656e16}
                                    );
                        complex_64 const p2 = evalpoly( 
                                              zinv * zinv,
                                              std::array<double,14>{0.125, 0.0732421875, 0.22710800170898438, 1.7277275025844574,
                                                                  24.380529699556064, 551.3358961220206, 18257.755474293175, 832859.3040162893,
                                                                  5.0069589531988926e7, 3.8362551802304335e9, 3.6490108188498334e11,
                                                                  4.218971570284097e13, 5.827244631566907e15, 9.47628809926011e17}
                                                      );
                        r = e * sinv * ((p2 * zinv) + p) + im * ((p2 * -zinv) + p) * sinv / e;
                    }
                    else if (rez < 4.5)
                    {
                        complex_64 const _z = complex_64(imz, rez);
                        if (imz < 2.2)
                        {
                            // use power series for I0
                            r = evalpoly( z * z,
                                          std::array<double,16>{1.0, 0.25, 0.015625, 0.00043402777777777775, 6.781684027777777e-6, 6.781684027777778e-8,
                                                              4.709502797067901e-10, 2.4028075495244395e-12, 9.385966990329842e-15,
                                                              2.896903392077112e-17, 7.242258480192779e-20, 1.4963343967340453e-22,
                                                              2.5978027721077174e-25, 3.842903509035085e-28, 4.9016626390753635e-31, 5.4462918211948485e-34}
                                        );
                        }
                        else
                        {
                            // use taylor series around the roots (slight offset) of J0(z)
                            // use relation I0(z) = J0(im*z)
                            // use taylor series along imaginary axis to compute J0 then use connection to I0
                            if (imz < 5.5)
                            {
                                r = evalpoly( _z - 4.0,
                                              std::array<double,31>{-0.39714980986384735, 0.06604332802354913, 0.19031948892898004, -0.02617922741442789,
                                                                  -0.012327254937700382, 0.0013954187466492201, 0.0003383564874916576, -3.2352699991643884e-5,
                                                                  -5.19447498672009e-6, 4.288219153645963e-7, 5.110006887219985e-8, -3.706408095359726e-9,
                                                                  -3.498992638539183e-10, 2.261387420545399e-11, 1.764093969853949e-12, -1.0276029888008532e-13,
                                                                  -6.822065455052696e-15, 3.615771894851861e-16, 2.087643213976906e-17, -1.0147714299511874e-18,
                                                                  -5.180949462623928e-20, 2.325268708649643e-21, 1.0636683330175965e-22, -4.433363402376956e-24,
                                                                  -1.8364438496343838e-25, 7.144077519453622e-27, 2.703432663739215e-28, -9.858964808813052e-30,
                                                                  -3.433416796708309e-31, 1.1783395850758042e-32, 3.8002747615197184e-34}
                                            );
                            }
                            else if (imz < 8.5)
                            {
                                r = evalpoly( _z - 7.0,
                                              std::array<double,31>{0.3000792705195556, 0.004682823482345833, -0.15037412265137393, 0.0063961298978456975,
                                                                  0.0117901293571031, -0.0005931489739085397, -0.00035284910023739957, 1.7226126084364155e-5,
                                                                  5.6607461669298285e-6, -2.5797924015210036e-7, -5.7071477461194966e-8, 2.405527610719961e-9,
                                                                  3.9654842151877684e-10, -1.5448890579256987e-11, -2.0176640921954225e-12, 7.282719360974481e-14,
                                                                  7.849059918114502e-15, -2.6338529522589484e-16, -2.4114034881541882e-17, 7.550478070536054e-19,
                                                                  6.00042409963671e-20, -1.7595225055714948e-21, -1.2341622420258064e-22, 3.400866475630264e-24,
                                                                  2.1334826847338247e-25, -5.542486611309409e-27, -3.14340708324299e-28, 7.721501146318583e-30,
                                                                  3.994514803313029e-31, -9.303265355325922e-33, -4.42301370247718e-34}
                                            );
                            }
                            else if (imz < 11.5)
                            {
