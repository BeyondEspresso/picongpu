            template<>
            struct J0<alpaka::Complex<float>>
                : public CbesseljBase<float>
            {
            public:
                HDINLINE result operator()(complex_T const& zin)
                {
                    double const SQ1O2PI = 0.3989422804014327;
                    complex_64 const im = complex_64(0.0, 1.0);
                    complex_64 z = complex_64(zin) / im;
                    complex_64 r = complex_64(1.0, 0.0);
                    bool isconj = false;

                    if (z.real() < 0.0)
                    {
                        z = -z;
                    }
                    if (z.imag() < 0.0)
                    {
                        z = conj(z);
                        isconj = true;
                    }
                    if (math::norm(z) > 100.0)
                    {
                        complex_64 const zinv = 1.0 / z;
                        complex_64 const e = math::exp(z);
                        complex_64 const sinv = math::sqrt(zinv) * SQ1O2PI;
                        complex_64 const p = 
                            evalpoly( zinv * zinv,
                                      std::array<double,6>{1.0, 0.0703125, 0.112152099609375, 0.5725014209747314,
                                                          6.074042001273483, 110.01714026924674}
                                    );
                        complex_64 const p2 = zinv
                                  * evalpoly( zinv * zinv,
                                              std::array<double,6>{0.125, 0.0732421875, 0.22710800170898438,
                                                                  1.7277275025844574, 24.380529699556064, 551.3358961220206}
                                            );
                        r = e * sinv * (p + p2) + im * sinv * (p - p2) / e;
                    }
                    else
                    {
                        complex_64 const zz = z * z;
                        complex_64 const z4 = zz * zz;
                        r = evalpoly(
                                z4,
                                std::array<double,10>{1.0, 0.015625, 6.781684027777777e-6, 4.709502797067901e-10,
