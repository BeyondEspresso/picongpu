                    complex_64 const im = complex_64(0.0, 1.0);
                    complex_64 c = complex_64(1.0, 0.0);
                    complex_64 z = complex_64(zin) / im;
                    complex_64 r = complex_64(0.0, 0.0);
                    bool isconj = false;
                    // shift phase to 0 < angle(z) < pi/2
                    if (z.real() < 0.0)
                    {
                        z = -z;
                        c = -c;
                    }
                    if (z.imag() < 0.0)
                    {
                        z = conj(z);
                        isconj = true;
                    }
                    if (math::norm(z) > 100.0)
                    {
                        complex_64 const zinv = 1.0 / z;
                        complex_64 const e = math::exp(z);
                        complex_64 const sinv = math::sqrt(zinv) * SQ1O2PI;
                        complex_64 const p = 
                            evalpoly( zinv * zinv,
                                      std::array<double,7>{1.0, -0.1171875, -0.144195556640625, -0.6765925884246826,
                                                         -6.883914268109947, -121.59789187653587, -3302.2722944808525}
                                    );
                        complex_64 const p2 = zinv
                                  * evalpoly( zinv * zinv,
                                              std::array<double,7>{0.375, 0.1025390625, 0.2775764465332031, 1.993531733751297,
                                                                    27.248827311268542, 603.8440767050702, 19718.37591223663}
                                            );
                        r = e * sinv * (p - p2) - im * sinv * (p + p2) / e;
