 */
                            // fw = f .* w (precomputed the result here)
                            std::array<complex_64,17> const fw = std::array<complex_64,17>{-0.034158680088344676 + 0.0005322553555455398 * im, -0.010133988170110419 + 0.003294578095064659 * im,
                                                                          -0.04941141979317253 + 0.03943570360902214 * im, -0.04282443791737565 + 0.04067202522589414 * im,
                                                                          -0.017101944936947666 + -0.04329512687943482 * im, -0.050068498055898046 - 0.061983773175692224 * im,
                                                                          0.05802205837241973 + 0.030587481401254276 * im, -0.04843183220930393 - 0.04156153578475886 * im,
                                                                          -0.03874032390966677 + 0.04979776968964296 * im, -0.08196010094295582 - 0.001962588580324914 * im,
                                                                          -0.012420246441149486 + 0.05603981714814329 * im, 0.06542742388716644 - 0.10686521199446769 * im,
                                                                          -0.0021961711227284787 + 0.09477395397525165 * im, -0.09136660023209353 - 0.033595214007004714 * im,
                                                                          0.12518502347992005 - 0.06120552447673005 * im, 0.20789490267497918 + 0.12736378916685936 * im,
                                                                          0.02228140162250047 - 0.0919881403144798 * im};
                            complex_64 s1 = complex_64(0.0, 0.0);
                            complex_64 s2 = complex_64(0.0, 0.0);
                            for (size_t ind = 0; ind < fw.size(); ++ind)
